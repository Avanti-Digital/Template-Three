---
import PageLayout from '../layouts/PageLayout.astro';
import HeroSection from '../components/HeroSection/HeroSection.astro';
import ServicesSection from '../components/ServicesSection/ServicesSection.astro';
import FeaturedProjects from '../components/FeaturedProjects/FeaturedProjects.astro';
import ProcessSection from '../components/ProcessSection/ProcessSection.astro';
import TrustSection from '../components/TrustSection/TrustSection.astro';
import PrimaryButton from '../components/PrimaryButton/PrimaryButton.astro';
import global from '../content/global.json';
import pages from '../content/pages.json';
---
<PageLayout title={global.seo.home.title} description={global.seo.home.description}>
  <HeroSection />
  <ServicesSection />
  <FeaturedProjects />
  <ProcessSection />
  <TrustSection />
  <section class="cta-band">
    <div class="cta-band__grid shell">
      <div>
        <p class="eyebrow">{pages.home.finalCta.kicker}</p>
        <h2>{pages.home.finalCta.heading}</h2>
      </div>
      <div>
        <p>{pages.home.finalCta.body}</p>
        <PrimaryButton href="/contact/" label={global.business.primaryCta} variant="dark" />
      </div>
    </div>
  </section>
</PageLayout>
