---
import './ProcessSection.css';
import content from './content.json';
---
<section class="process section section--dark">
  <div class="shell">
    <div class="process__header">
      <p class="process__number">{content.number}</p>
      <div><p class="eyebrow">{content.kicker}</p><h2>{content.heading}</h2></div>
    </div>
    <ol class="process__steps">
      {content.steps.map((step) => (
        <li><span>{step.number}</span><h3>{step.title}</h3><p>{step.body}</p></li>
      ))}
    </ol>
  </div>
</section>
